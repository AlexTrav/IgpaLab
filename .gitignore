# секреты (ключ OpenAI и т.п.) – только в переменных окружения
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# frontend
node_modules/
dist/
*.local

# временные файлы Excel
~$*.xlsx

# CSV для просмотра и пробные версии синтетики – воспроизводятся командами make в data/
data/synthetic/*/csv/
data/synthetic/_*/
# версии для проверок воспроизводятся командой (docs/data.md), в git только паспорта
data/synthetic/v1-*/*
!data/synthetic/v1-*/passport.md

# логи
*.log

# IDE и ОС
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# логи долгих прогонов моделей
model/results/logs/

# открытые наборы для серии S5 – скачиваются командой make -C data open
data/open/
